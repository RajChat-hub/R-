# Paths resolve relative to this configuration file.
server {
 listen "127.0.0.1:8080";
 root "www";
 max_connections 256;
 max_requests 100;
 header_bytes 16384;
 header_count 100;
 body_bytes 1048576;
 idle_ms 10000;
 request_ms 5000;
 write_ms 10000;
 shutdown_ms 3000;
 host "example.test" { root "www"; }
}
